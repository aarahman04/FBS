# Comma-separated list of origins allowed to call this API. Set this to your
# Vercel frontend URL(s) once deployed -- e.g.
# https://fbs.vercel.app,https://fbs-git-main-yourname.vercel.app
# Leave unset locally; the app then falls back to "*".
# NOTE: this must track the domain the frontend is actually served from. A
# stale value here blocks every API call, and the browser reports it only as
# a generic "Load failed".
ALLOWED_ORIGINS=

# Optional regex for origins that can't be listed exactly -- Vercel preview
# deployments get a generated hostname per build. e.g.
# ^https://fbs-[a-z0-9]+-yourname\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# Supabase Postgres connection string. Use the SESSION POOLER (Dashboard ->
# Connect -> Session pooler), NOT the direct connection: db.<ref>.supabase.co
# resolves to IPv6 only, and hosts without IPv6 egress (Railway among them)
# fail with "Network is unreachable". Session mode keeps prepared statements
# working, unlike transaction mode.
# Percent-encode the password -- an unencoded '@' or '#' silently breaks URL
# parsing and shows up as a bogus hostname in DNS errors.
DATABASE_URL=

# Your Supabase project URL. Used to fetch the JWKS public keys that verify
# the bearer token Supabase issues on sign-in. Current Supabase projects sign
# tokens asymmetrically (ES256), so this is the one that matters.
SUPABASE_URL=https://your-project.supabase.co

# Only needed for older projects still signing symmetrically (HS256):
# Dashboard -> Settings -> API -> JWT Secret. Leave blank if SUPABASE_URL is
# set and your project uses asymmetric keys.
SUPABASE_JWT_SECRET=
