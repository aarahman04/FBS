# Public HTTPS URL of the deployed backend (Railway). Without this, the app
# calls /api, which only exists via the local Vite dev proxy.
VITE_API_BASE=https://your-backend.up.railway.app

# Supabase project URL and anon (public) key. Dashboard -> Settings -> API.
# Both are safe to expose client-side -- access is enforced server-side by
# the backend verifying the bearer JWT, not by keeping these secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
